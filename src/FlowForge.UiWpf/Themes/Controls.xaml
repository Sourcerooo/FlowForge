<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.18"
                                  Color="{Binding Source={StaticResource CardShadowColorBrush}, Path=Color}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
        <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
    </Style>

    <Style x:Key="CompactPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CompactPanelPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource SmallCardCornerRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CompactPanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource CompactPanelBackgroundBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.10"
                                  Color="{Binding Source={StaticResource CardShadowColorBrush}, Path=Color}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarButtonBaseStyle" TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ToolbarBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14"
                                              ShadowDepth="0"
                                              Opacity="0.08"
                                              Color="{Binding Source={StaticResource ButtonShadowColorBrush}, Path=Color}" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ToolbarHoverBorderBrush}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBaseStyle}" />

    <Style x:Key="ToolbarButtonPrimaryStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ToolbarPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarPrimaryBorderBrush}" />
    </Style>

    <Style x:Key="ToolbarGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource NavButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource NavForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StageCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
        <Setter Property="Padding" Value="{StaticResource StageCardPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style x:Key="MetricPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource MetricPillPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource SmallCardCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource MetricPillBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="WorkerChipStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource WorkerCardPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource SmallCardCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ScreenPanelCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
        <Setter Property="Padding" Value="{StaticResource ScreenCardPadding}" />
    </Style>

    <Style x:Key="SelectableStageButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="StageChrome"
                            Background="{Binding Background}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="{StaticResource CardCornerRadius}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.18"
                                              Color="{Binding Source={StaticResource CardShadowColorBrush}, Path=Color}" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StageChrome" Property="BorderBrush" Value="{Binding AccentBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="StageChrome" Property="BorderBrush" Value="{Binding AccentBrush}" />
                            <Setter TargetName="StageChrome" Property="BorderThickness" Value="2.5" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource ScreenActionButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionChrome"
                            Background="{Binding Background}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SmallCardCornerRadius}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.14"
                                              Color="{Binding Source={StaticResource CardShadowColorBrush}, Path=Color}" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ActionChrome" Property="Opacity" Value="0.92" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InsightTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Margin="10,12,10,0"
                                Padding="6"
                                CornerRadius="14"
                                Background="{DynamicResource PanelSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1">
                            <TabPanel IsItemsHost="True" Background="Transparent" />
                        </Border>
                        <ContentPresenter Grid.Row="1"
                                          Margin="0"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InsightTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabChrome"
                            Margin="2"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource SparklineCardBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
