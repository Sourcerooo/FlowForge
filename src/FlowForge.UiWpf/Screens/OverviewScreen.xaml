<UserControl x:Class="FlowForge.UiWpf.Screens.OverviewScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:FlowForge.UiWpf"
             mc:Ignorable="d">
    <Grid x:Name="OverviewRoot" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="14" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="OverviewRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" />
                        <DoubleAnimation Storyboard.TargetName="OverviewRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource ColumnSpacingWidth}" />
            <ColumnDefinition Width="{StaticResource RightRailColumnWidth}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource ColumnSpacingWidth}" />
            <RowDefinition Height="{StaticResource TimelineRowHeight}" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ScreenPanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Simulation Flow" />
                    <TextBlock Grid.Column="1" Style="{StaticResource HeaderLabelStyle}" Text="Compact stages with detail-on-select for 3-5 stage flows" />
                </Grid>

                <Border Grid.Row="2" Padding="20" CornerRadius="{StaticResource InnerCardCornerRadius}" Background="{DynamicResource CanvasSurfaceBrush}" BorderBrush="{DynamicResource SoftBlueBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource HeaderLabelStyle}" Text="Select a stage to inspect full station metrics and worker status without expanding every card in the main process flow." />

                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Padding="14" CornerRadius="{StaticResource InnerCardCornerRadius}" Background="{Binding SourceNode.Background}" BorderBrush="{Binding SourceNode.BorderBrush}" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SourceNode.Title}" />
                                    <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{Binding SourceNode.AccentBrush}" Text="{Binding SourceNode.Value}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SourceNode.Subtitle}" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                                <ItemsControl ItemsSource="{Binding Stages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:StageSummaryViewModel}">
                                            <Grid Margin="0,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>

                                                <Button Style="{StaticResource SelectableStageButtonStyle}"
                                                        Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Padding="12" Background="Transparent" BorderThickness="0">
                                                        <StackPanel>
                                                            <TextBlock Foreground="{Binding AccentBrush}" FontWeight="SemiBold" Text="{Binding SequenceLabel}" />
                                                            <TextBlock Margin="0,4,0,0" FontFamily="Bahnschrift" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding StageName}" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding StationName}" />
                                                            <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding QueueText}" />
                                                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding WorkerSummary}" />
                                                            <TextBlock Margin="0,3,0,0" Foreground="{Binding AccentBrush}" Text="{Binding UtilizationText}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Button>

                                                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasNextStage}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Canvas Width="32" Height="44">
                                                        <Path Stroke="{Binding AccentBrush}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,22 L 28,22 M 18,12 L 28,22 L 18,32" />
                                                        <Ellipse x:Name="FlowPulse" Width="7" Height="7" Fill="{Binding AccentBrush}" Opacity="0.18" Canvas.Left="4" Canvas.Top="18">
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform X="0" />
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                        <Canvas.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetName="FlowPulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="16" Duration="0:0:1.4" />
                                                                        <DoubleAnimation Storyboard.TargetName="FlowPulse" Storyboard.TargetProperty="Opacity" From="0.12" To="0.58" Duration="0:0:0.7" AutoReverse="True" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Canvas.Triggers>
                                                    </Canvas>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border x:Name="SelectedStagePanel" Grid.Row="2" Margin="{StaticResource DetailPanelMargin}" Style="{StaticResource StageCardStyle}" Background="{Binding SelectedStage.Background}" BorderBrush="{Binding SelectedStage.AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Foreground="{Binding SelectedStage.AccentBrush}" FontWeight="SemiBold" Text="Selected Stage" />
                                        <TextBlock Margin="0,4,0,0" FontFamily="Bahnschrift" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedStage.StageName}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource HeaderLabelStyle}" Text="{Binding SelectedStage.SequenceLabel}" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Margin="0,16,0,0" Padding="14" CornerRadius="14" Background="{DynamicResource StageDetailSurfaceBrush}" BorderBrush="{Binding SelectedStage.BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Station" />
                                                <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedStage.StationName}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="10,4" CornerRadius="10" Background="{DynamicResource InfoSurfaceBrush}">
                                                <TextBlock Foreground="{Binding SelectedStage.AccentBrush}" FontWeight="SemiBold" Text="{Binding SelectedStage.WorkerSummary}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <UniformGrid Grid.Row="2" Margin="12,14,0,0" Columns="2">
                                        <Border Style="{StaticResource MetricPillStyle}">
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Queue" />
                                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedStage.QueueText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="10,0,0,0" Style="{StaticResource MetricPillStyle}">
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Avg Processing" />
                                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedStage.ProcessingTimeText}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>

                                <Border Grid.Column="2" Padding="14" CornerRadius="{StaticResource InnerCardCornerRadius}" Background="{DynamicResource StageDetailSurfaceBrush}" BorderBrush="{Binding SelectedStage.BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="Worker Allocation" />
                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource HeaderLabelStyle}" Text="{Binding SelectedStage.UtilizationText}" />
                                        <ItemsControl Grid.Row="2" Margin="10,14,0,0" ItemsSource="{Binding SelectedStage.Workers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:WorkerViewModel}">
                                                    <Border Margin="0,0,6,0" MinWidth="0" Style="{StaticResource WorkerChipStyle}" Background="{Binding BackgroundBrush}" BorderBrush="{Binding AccentBrush}">
                                                        <StackPanel>
                                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Text="{Binding Label}" />
                                                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Status}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="{StaticResource PanelHeaderPadding}" CornerRadius="18,18,0,0" Background="{DynamicResource PanelHeaderBrush}">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Timeline &amp; Event Inspector" />
                </Border>
                <Grid Grid.Row="1" Margin="{StaticResource TimelineInnerMargin}">
                    <Canvas Height="42">
                        <Line X1="18" Y1="18" X2="760" Y2="18" Stroke="{DynamicResource DividerBrush}" StrokeThickness="2" />
                        <ItemsControl ItemsSource="{Binding TimelineEntries}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding MarkerPosition}" /></Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TimelineEntryViewModel}">
                                    <StackPanel>
                                        <Ellipse Width="8" Height="8" Fill="{Binding MarkerBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Margin="-10,6,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding TimeLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Grid>
                <ListView Grid.Row="2" Margin="{StaticResource ListContainerMargin}" BorderThickness="0" Background="Transparent" ItemsSource="{Binding EventEntries}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:EventEntryViewModel}">
                            <Border Padding="12" CornerRadius="12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource PanelSurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding TimeLabel}" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                    <Border Grid.Column="2" Padding="10,4" CornerRadius="10" Background="{Binding BadgeBackground}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}" Text="{Binding BadgeText}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <ScrollViewer Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="{StaticResource PanelHeaderPadding}" CornerRadius="18,18,0,0" Background="{DynamicResource PanelHeaderBrush}"><TextBlock Style="{StaticResource PanelTitleStyle}" Text="KPI Summary" /></Border>
                        <StackPanel Grid.Row="1" Margin="16,14,16,16">
                            <ItemsControl ItemsSource="{Binding HeroMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:HeroMetricViewModel}">
                                        <Border Margin="0,0,0,12" Padding="14" CornerRadius="16" Background="{Binding SurfaceBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1.2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Label}" />
                                                <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
                                                    <TextBlock FontFamily="Bahnschrift" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Text="{Binding Value}" />
                                                    <TextBlock Margin="8,10,0,0" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Unit}" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Context}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,4,0,10" Padding="12" CornerRadius="12" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Primary Monitoring Goal" />
                                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="Flow stability across queue pressure, utilization and WIP" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,4" CornerRadius="10" Background="{DynamicResource InfoSurfaceBrush}">
                                        <TextBlock Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold" Text="Snapshot-driven" />
                                    </Border>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding KpiMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MetricViewModel}">
                                        <Grid Margin="{StaticResource MetricSpacing}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="{Binding ValueBrush}" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="{StaticResource RightColumnCardMargin}" Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="{StaticResource PanelHeaderPadding}" CornerRadius="18,18,0,0" Background="{DynamicResource PanelHeaderBrush}"><TextBlock Style="{StaticResource PanelTitleStyle}" Text="Trend Analysis" /></Border>
                        <ItemsControl Grid.Row="1" Margin="16,14,16,12" ItemsSource="{Binding TrendSeries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TrendSeriesViewModel}">
                                    <Grid Margin="{StaticResource TrendSpacing}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                        <Border Grid.Column="1" Height="40" Padding="6" CornerRadius="10" Background="{DynamicResource SparklineCardBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                            <Grid>
                                                <Rectangle RadiusX="8" RadiusY="8" Fill="{Binding BackgroundBrush}" />
                                                <Polyline Stroke="{Binding StrokeBrush}" StrokeThickness="2" VerticalAlignment="Center">
                                                    <Polyline.Points>
                                                        <Binding Path="Points" Converter="{StaticResource SparklineConverter}" ConverterParameter="156,28" />
                                                    </Polyline.Points>
                                                </Polyline>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Margin="{StaticResource RightColumnCardMargin}" Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Border Padding="{StaticResource PanelHeaderPadding}" CornerRadius="18,18,0,0" Background="{DynamicResource PanelHeaderBrush}"><TextBlock Style="{StaticResource PanelTitleStyle}" Text="Risk / Alert Panel" /></Border>
                            <Button HorizontalAlignment="Right" Margin="0,8,12,0" Style="{StaticResource ToolbarGhostButtonStyle}" Command="{Binding DataContext.OpenAlertsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Open" />
                        </Grid>
                        <ItemsControl Grid.Row="1" Margin="16,14,16,16" ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AlertItemViewModel}">
                                    <Button Margin="{StaticResource AlertSpacing}" Style="{StaticResource ListActionButtonStyle}" Command="{Binding DataContext.OpenAlertsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{Binding IconBrush}" Text="{Binding IconGlyph}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                            <Border Grid.Column="2" Width="4" CornerRadius="2" Background="{Binding IconBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Margin="{StaticResource RightColumnCardMargin}" Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Border Padding="{StaticResource PanelHeaderPadding}" CornerRadius="18,18,0,0" Background="{DynamicResource PanelHeaderBrush}"><TextBlock Style="{StaticResource PanelTitleStyle}" Text="Recommendations" /></Border>
                            <Button HorizontalAlignment="Right" Margin="0,8,12,0" Style="{StaticResource ToolbarGhostButtonStyle}" Command="{Binding DataContext.OpenRecommendationsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Open" />
                        </Grid>
                        <ItemsControl Grid.Row="1" Margin="16,14,16,16" ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:RecommendationItemViewModel}">
                                    <Button Margin="{StaticResource RecommendationSpacing}" Style="{StaticResource ListActionButtonStyle}" Command="{Binding DataContext.OpenRecommendationsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="18" Height="18" VerticalAlignment="Top" Fill="{Binding BadgeBrush}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
