<UserControl x:Class="FlowForge.UiWpf.Screens.OverviewScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:FlowForge.UiWpf"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="OverviewRoot" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="14" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="OverviewRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" />
                        <DoubleAnimation Storyboard.TargetName="OverviewRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource ColumnSpacingWidth}" />
            <ColumnDefinition Width="336" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource ColumnSpacingWidth}" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ScreenPanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Simulation Flow" />
                    <TextBlock Grid.Column="1" Style="{StaticResource HeaderLabelStyle}" Text="Process-first overview with zoomed stage inspection" />
                </Grid>

                <Border Grid.Row="2"
                        Padding="20"
                        CornerRadius="{StaticResource InnerCardCornerRadius}"
                        Background="{DynamicResource CanvasSurfaceBrush}"
                        BorderBrush="{DynamicResource SoftBlueBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource HeaderLabelStyle}" Text="The process flow stays fully visible in one glance. Click any stage to zoom into station metrics and worker allocation below." />

                        <Border Grid.Row="1"
                                Margin="0,18,0,0"
                                Padding="14"
                                CornerRadius="18"
                                Background="{DynamicResource PanelSurfaceBrush}"
                                BorderBrush="{DynamicResource SoftBlueBorderBrush}"
                                BorderThickness="1">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <Canvas Width="860" Height="334">
                                    <ItemsControl ItemsSource="{Binding StageConnections}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                                <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:StageConnectionViewModel}">
                                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                    <Canvas>
                                                        <Path x:Name="ArrowPath" Stroke="{Binding AccentBrush}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        <Polygon x:Name="ArrowHead" Fill="{Binding AccentBrush}" />
                                                        <Border x:Name="ArrowGlow" Width="26" Height="10" CornerRadius="5" Background="{Binding AccentBrush}" Opacity="0.4">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Canvas>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Right">
                                                            <Setter TargetName="ArrowPath" Property="Data" Value="M 2,12 L 40,12" />
                                                            <Setter TargetName="ArrowHead" Property="Points" Value="34,1 48,12 34,23" />
                                                            <Setter TargetName="ArrowGlow" Property="Canvas.Left" Value="3" />
                                                            <Setter TargetName="ArrowGlow" Property="Canvas.Top" Value="7" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetName="ArrowGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="16" Duration="0:0:0.75" />
                                                                        <DoubleAnimation Storyboard.TargetName="ArrowGlow" Storyboard.TargetProperty="Opacity" From="0.18" To="0.95" Duration="0:0:0.37" AutoReverse="True" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Left">
                                                            <Setter TargetName="ArrowPath" Property="Data" Value="M 46,12 L 8,12" />
                                                            <Setter TargetName="ArrowHead" Property="Points" Value="14,1 0,12 14,23" />
                                                            <Setter TargetName="ArrowGlow" Property="Canvas.Left" Value="18" />
                                                            <Setter TargetName="ArrowGlow" Property="Canvas.Top" Value="7" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetName="ArrowGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-16" Duration="0:0:0.75" />
                                                                        <DoubleAnimation Storyboard.TargetName="ArrowGlow" Storyboard.TargetProperty="Opacity" From="0.18" To="0.95" Duration="0:0:0.37" AutoReverse="True" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Down">
                                                            <Setter TargetName="ArrowPath" Property="Data" Value="M 12,2 L 12,36" />
                                                            <Setter TargetName="ArrowHead" Property="Points" Value="1,30 12,44 23,30" />
                                                            <Setter TargetName="ArrowGlow" Property="Width" Value="10" />
                                                            <Setter TargetName="ArrowGlow" Property="Height" Value="28" />
                                                            <Setter TargetName="ArrowGlow" Property="Canvas.Left" Value="7" />
                                                            <Setter TargetName="ArrowGlow" Property="Canvas.Top" Value="6" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetName="ArrowGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="10" Duration="0:0:0.75" />
                                                                        <DoubleAnimation Storyboard.TargetName="ArrowGlow" Storyboard.TargetProperty="Opacity" From="0.18" To="0.95" Duration="0:0:0.37" AutoReverse="True" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Canvas.Left="0"
                                            Canvas.Top="0"
                                            Width="160"
                                            Height="134"
                                            Padding="14"
                                            CornerRadius="20"
                                            Background="{Binding SourceNode.Background}"
                                            BorderBrush="{Binding SourceNode.BorderBrush}"
                                            BorderThickness="2.2">
                                        <StackPanel>
                                            <TextBlock FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SourceNode.Title}" />
                                            <TextBlock Margin="0,14,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{Binding SourceNode.AccentBrush}" Text="{Binding SourceNode.Value}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SourceNode.Subtitle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Stages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                                <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:StageSummaryViewModel}">
                                                <Button Width="180"
                                                        Height="134"
                                                        Style="{StaticResource SelectableStageButtonStyle}"
                                                        Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Padding="12" Background="Transparent" BorderThickness="0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Foreground="{Binding AccentBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding SequenceLabel}" />
                                                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{Binding FlowBrush}" Text="{Binding UtilizationText}" />
                                                            </Grid>
                                                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                                                <TextBlock FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding StageName}" />
                                                                <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding StationName}" />
                                                                <Grid Margin="0,10,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding QueueText}" />
                                                                    <TextBlock Grid.Column="1" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding WorkerSummary}" />
                                                                </Grid>
                                                            </StackPanel>
                                                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <ItemsControl ItemsSource="{Binding QueuePackages}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type local:QueuePackageViewModel}">
                                                                            <Border Margin="0,0,6,0" Width="16" Height="10" CornerRadius="3" Background="{Binding Brush}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <UniformGrid Grid.Column="1" Columns="3">
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding Workers[0].AccentBrush}" HorizontalAlignment="Center" />
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding Workers[1].AccentBrush}" HorizontalAlignment="Center" />
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding Workers[2].AccentBrush}" HorizontalAlignment="Center" />
                                                                </UniformGrid>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border x:Name="SelectedStagePanel"
                                Grid.Row="2"
                                Margin="{StaticResource DetailPanelMargin}"
                                Style="{StaticResource StageCardStyle}"
                                Background="{DynamicResource PanelSurfaceBrush}"
                                BorderBrush="{Binding SelectedStage.AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Foreground="{Binding SelectedStage.AccentBrush}" FontWeight="SemiBold" Text="Selected Stage" />
                                            <TextBlock Margin="0,3,0,0" FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedStage.StageName}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource HeaderLabelStyle}" Text="{Binding SelectedStage.SequenceLabel}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource MetricPillStyle}">
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Station" />
                                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedStage.StationName}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource MetricPillStyle}">
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Queue" />
                                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedStage.QueueText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource MetricPillStyle}">
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Avg Processing" />
                                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedStage.ProcessingTimeText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource MetricPillStyle}">
                                            <StackPanel>
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Workers" />
                                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{Binding SelectedStage.AccentBrush}" Text="{Binding SelectedStage.WorkerSummary}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <Border Grid.Column="2"
                                        Padding="14"
                                        CornerRadius="{StaticResource InnerCardCornerRadius}"
                                        Background="{DynamicResource StageDetailSurfaceBrush}"
                                        BorderBrush="{Binding SelectedStage.BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="Worker Allocation" />
                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource HeaderLabelStyle}" Text="{Binding SelectedStage.UtilizationText}" />
                                        <ItemsControl Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding SelectedStage.Workers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:WorkerViewModel}">
                                                    <Border Margin="0,0,6,0" Style="{StaticResource WorkerChipStyle}" Background="{Binding BackgroundBrush}" BorderBrush="{Binding AccentBrush}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Text="{Binding Label}" />
                                                            <TextBlock Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Status}" />
                                                            <TextBlock Grid.Row="2"
                                                                       Margin="0,6,0,0"
                                                                       HorizontalAlignment="Center"
                                                                       FontFamily="Segoe Fluent Icons"
                                                                       FontSize="15"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       Text="&#xE713;">
                                                                <TextBlock.RenderTransform>
                                                                    <RotateTransform Angle="0" CenterX="8" CenterY="8" />
                                                                </TextBlock.RenderTransform>
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.8" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ToggleButton IsChecked="{Binding IsTimelineExpanded, Mode=TwoWay}"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0">
                <Border Padding="{StaticResource PanelHeaderPadding}" CornerRadius="18" Background="{DynamicResource PanelHeaderBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <Grid Width="Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe Fluent Icons" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE70E;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Style="{StaticResource PanelTitleStyle}" Text="Timeline &amp; Event Inspector" />
                    </Grid>
                </Border>
            </ToggleButton>
            <Border Grid.Row="1" Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTimelineExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="{StaticResource TimelineInnerMargin}">
                        <Canvas Height="42">
                            <Line X1="18" Y1="18" X2="760" Y2="18" Stroke="{DynamicResource DividerBrush}" StrokeThickness="2" />
                            <ItemsControl ItemsSource="{Binding TimelineEntries}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding MarkerPosition}" /></Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TimelineEntryViewModel}">
                                        <StackPanel>
                                            <Ellipse Width="8" Height="8" Fill="{Binding MarkerBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Margin="-10,6,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding TimeLabel}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                    <ListView Grid.Row="2" Margin="{StaticResource ListContainerMargin}" BorderThickness="0" Background="Transparent" ItemsSource="{Binding EventEntries}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:EventEntryViewModel}">
                                <Border Padding="12" CornerRadius="12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource PanelSurfaceBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding TimeLabel}" />
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                        <Border Grid.Column="2" Padding="10,4" CornerRadius="10" Background="{Binding BadgeBackground}">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}" Text="{Binding BadgeText}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource ColumnSpacingWidth}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="{StaticResource PanelHeaderPadding}" CornerRadius="18,18,0,0" Background="{DynamicResource PanelHeaderBrush}">
                        <TextBlock Style="{StaticResource PanelTitleStyle}" Text="KPI Summary" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="16,14,16,16">
                        <ItemsControl ItemsSource="{Binding HeroMetrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HeroMetricViewModel}">
                                    <Border Margin="0,0,0,10" Padding="14" CornerRadius="16" Background="{Binding SurfaceBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1.2">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Label}" />
                                            <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
                                                <TextBlock FontFamily="Bahnschrift" FontSize="26" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Text="{Binding Value}" />
                                                <TextBlock Margin="8,9,0,0" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Unit}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Context}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                <TabControl Margin="0" Background="Transparent" BorderThickness="0" Style="{StaticResource InsightTabControlStyle}">
                    <TabItem Header="Core KPIs" Style="{StaticResource InsightTabItemStyle}">
                        <StackPanel Margin="16,14,16,16">
                            <Border Margin="0,0,0,10" Padding="12" CornerRadius="12" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Primary Monitoring Goal" />
                                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="Flow stability across queue pressure, utilization and WIP" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,4" CornerRadius="10" Background="{DynamicResource InfoSurfaceBrush}">
                                        <TextBlock Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold" Text="Snapshot-driven" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding KpiMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MetricViewModel}">
                                        <Grid Margin="{StaticResource MetricSpacing}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="{Binding ValueBrush}" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Trends" Style="{StaticResource InsightTabItemStyle}">
                        <ItemsControl Margin="16,14,16,12" ItemsSource="{Binding TrendSeries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TrendSeriesViewModel}">
                                    <Grid Margin="{StaticResource TrendSpacing}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                        <Border Grid.Column="1" Height="40" Padding="6" CornerRadius="10" Background="{DynamicResource SparklineCardBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                            <Grid>
                                                <Rectangle RadiusX="8" RadiusY="8" Fill="{Binding BackgroundBrush}" />
                                                <Polyline Stroke="{Binding StrokeBrush}" StrokeThickness="2" VerticalAlignment="Center">
                                                    <Polyline.Points>
                                                        <Binding Path="Points" Converter="{StaticResource SparklineConverter}" ConverterParameter="156,28" />
                                                    </Polyline.Points>
                                                </Polyline>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="Alerts" Style="{StaticResource InsightTabItemStyle}">
                        <StackPanel Margin="16,14,16,16">
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AlertItemViewModel}">
                                        <Button Margin="{StaticResource AlertSpacing}" Style="{StaticResource ListActionButtonStyle}" Command="{Binding DataContext.OpenAlertsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{Binding IconBrush}" Text="{Binding IconGlyph}" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding TargetStageName}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Foreground="{DynamicResource MutedTextBrush}" Text="Open" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Actions" Style="{StaticResource InsightTabItemStyle}">
                        <StackPanel Margin="16,14,16,16">
                            <ItemsControl ItemsSource="{Binding Recommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:RecommendationItemViewModel}">
                                        <Button Margin="{StaticResource RecommendationSpacing}" Style="{StaticResource ListActionButtonStyle}" Command="{Binding DataContext.OpenRecommendationsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Ellipse Width="18" Height="18" VerticalAlignment="Top" Fill="{Binding BadgeBrush}" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding ImpactPreview}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Foreground="{DynamicResource MutedTextBrush}" Text="Open" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
