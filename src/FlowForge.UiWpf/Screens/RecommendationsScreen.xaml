<UserControl x:Class="FlowForge.UiWpf.Screens.RecommendationsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlowForge.UiWpf">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource ScreenPanelCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recommendation Queue" />
                <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RecommendationItemViewModel}">
                            <Button Margin="{StaticResource ScreenListItemMargin}" Style="{StaticResource ListActionButtonStyle}" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" Command="{Binding DataContext.SelectRecommendationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Ellipse Width="18" Height="18" Fill="{Binding BadgeBrush}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding Description}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource ScreenPanelCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recommendation Detail" />
                <TextBlock Margin="0,18,0,0" FontFamily="Bahnschrift" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding SelectedRecommendation.Title}" />
                <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding SelectedRecommendation.Description}" />
                <Border Margin="0,14,0,0" Padding="12" CornerRadius="12" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Impact Preview" />
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{Binding SelectedRecommendation.BadgeBrush}" Text="{Binding SelectedRecommendation.ImpactPreview}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,18,0,0" Padding="16" CornerRadius="12" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{Binding SelectedRecommendation.BadgeBrush}" BorderThickness="1">
                    <TextBlock Foreground="{DynamicResource StrongTextBrush}" Text="This screen can later host side-by-side impact estimates, required actions and apply/reject decisions." TextWrapping="Wrap" />
                </Border>
                <Button Margin="0,18,0,0"
                        Style="{StaticResource ToolbarButtonPrimaryStyle}"
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.FocusStageInOverviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding SelectedRecommendation.TargetStageName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE71B;" />
                        <TextBlock Text="Preview On Stage" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
