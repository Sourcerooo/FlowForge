<UserControl x:Class="FlowForge.UiWpf.Screens.SettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlowForge.UiWpf">
    <Border Style="{StaticResource ScreenPanelCardStyle}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Settings &amp; Theme" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource HeaderLabelStyle}" Text="The interactive mockup keeps settings separate from the overview and exposes theme control in the header." />
            <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding SettingCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:InfoCardViewModel}">
                        <Border Margin="{StaticResource ScreenListItemMargin}" Padding="16" CornerRadius="12" Background="{Binding Background}" BorderBrush="{Binding AccentBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Foreground="{Binding AccentBrush}" FontWeight="SemiBold" Text="{Binding Subtitle}" />
                                <TextBlock Margin="0,4,0,0" FontFamily="Bahnschrift" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" Text="{Binding Title}" />
                                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding Description}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
