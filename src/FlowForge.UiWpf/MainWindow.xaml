<Window x:Class="FlowForge.UiWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlowForge.UiWpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel, IsDesignTimeCreatable=True}"
        Title="FlowForge Desktop"
        Width="1520"
        Height="980"
        MinWidth="1280"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppShellBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootShell"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.35" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootShell"
            Margin="{StaticResource WindowOuterMargin}"
            Padding="{StaticResource WindowInnerPadding}"
            Opacity="0"
            d:Opacity="1"
            CornerRadius="{StaticResource WindowCornerRadius}"
            Background="{DynamicResource AppSurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              ShadowDepth="0"
                              Opacity="0.22"
                              Color="{Binding Source={StaticResource WindowShadowColorBrush}, Path=Color}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButtonPrimaryStyle}" Command="{Binding RunCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE768;" />
                                <TextBlock Text="Run" />
                            </StackPanel>
                        </Button>
                        <Button Margin="{StaticResource ToolbarButtonSpacing}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PauseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE769;" />
                                <TextBlock Text="Pause" />
                            </StackPanel>
                        </Button>
                        <Button Margin="{StaticResource ToolbarButtonSpacing}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ResetCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE72C;" />
                                <TextBlock Text="Reset" />
                            </StackPanel>
                        </Button>
                        <Button Margin="{StaticResource ToolbarGhostButtonSpacing}" Style="{StaticResource ToolbarGhostButtonStyle}" Command="{Binding LoadScenarioCommand}" Content="Load Scenario" />
                        <Button Margin="{StaticResource ToolbarGhostButtonSpacing}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ToggleThemeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE793;" />
                                <TextBlock Text="{Binding ThemeButtonLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HeaderLabelStyle}" Text="Simulation Time" />
                        <TextBlock Margin="{StaticResource HeaderValueMargin}" Style="{StaticResource HeaderValueStyle}" Text="12:42:15" />
                        <Border Margin="{StaticResource HeaderSeparatorMargin}" Width="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel Margin="{StaticResource ConnectedStatusMargin}" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock Style="{StaticResource HeaderLabelStyle}" Text="Connected" />
                        </StackPanel>
                        <Border Margin="{StaticResource ConnectedStatusMargin}" Padding="12,6" CornerRadius="12" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource SoftBlueBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryAccentBrush}" Text="&#xE895;" />
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource HeaderLabelStyle}">
                                    <Run Text="Mode: " />
                                    <Run Text="{Binding SimulationModeLabel}" Foreground="{DynamicResource StrongTextBrush}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource HeaderLabelStyle}">
                        <Run Text="Scenario: " />
                        <Run Text="Demand Spike West" Foreground="{DynamicResource StrongTextBrush}" FontWeight="SemiBold" />
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="{StaticResource SectionTopMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource SidebarColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource ColumnSpacingWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="12" Style="{StaticResource SidebarStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="Workspace" />
                        <Border Grid.Row="1" Margin="{StaticResource SidebarPanelMargin}" Style="{StaticResource CompactPanelStyle}">
                            <StackPanel>
                                <TextBlock FontFamily="Bahnschrift" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource NavForegroundBrush}" Text="{Binding CurrentWorkspaceTitle}" />
                                <TextBlock Margin="{StaticResource WorkspaceDescriptionMargin}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource CompactPanelForegroundBrush}" Text="{Binding CurrentWorkspaceDescription}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl Grid.Row="2" Margin="{StaticResource SidebarListMargin}" ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:NavigationItemViewModel}">
                                    <Button Margin="{StaticResource SidebarButtonMargin}" Style="{StaticResource NavButtonStyle}" Command="{Binding DataContext.SelectNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,10,0" FontFamily="Segoe Fluent Icons" Text="{Binding IconGlyph}" />
                                            <TextBlock Text="{Binding Label}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="3">
                            <Border Margin="{StaticResource SidebarFooterCardMargin}" Style="{StaticResource CompactPanelStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryAccentBrush}" Text="&#xE81E;" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{DynamicResource NavForegroundBrush}" Text="Scenario A" />
                                    <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource NavForegroundBrush}" Text="&#xE70D;" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CompactPanelStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource CompactPanelForegroundBrush}" Text="Mock state" />
                                    <TextBlock Margin="{StaticResource WorkspaceDescriptionMargin}" FontFamily="Bahnschrift" FontWeight="SemiBold" Foreground="{DynamicResource NavForegroundBrush}" Text="{Binding SimulationModeLabel}" />
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource CompactPanelForegroundBrush}" Text="{Binding SimulationModeDetail}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        x:Name="ScreenContentHost"
                        Background="Transparent"
                        Opacity="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Border.RenderTransform>
                    <ContentControl Content="{Binding CurrentScreen}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
